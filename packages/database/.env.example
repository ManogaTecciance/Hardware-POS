# Prisma reads DATABASE_URL for schema generation, migrations, and Studio.
# Copy to `.env` in this package (or export from the repo-root `.env`).
# Migrations always use a direct (non-pooled) connection — for Neon, use the
# direct endpoint URL here (no `-pooler` in the host) with `sslmode=require`.
#
# IMPORTANT: keep this pointing at the SAME database as apps/api/.env. The
# generated Prisma client loads this file into process.env at import time,
# BEFORE the API's ConfigModule reads apps/api/.env — and dotenv never
# overrides existing values, so a mismatch here silently wins.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hardware_pos?schema=public"
