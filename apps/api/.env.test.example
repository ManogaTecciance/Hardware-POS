# Hardware POS API — integration-test environment.
#
# Copy to apps/api/.env.test (gitignored) if you want to run the suite without
# exporting variables by hand. `pnpm test:integration` from the repo root sets
# these for you, so this file is documentation + an escape hatch.
#
# ─────────────────────────────────────────────────────────────────────────────
# SAFETY: apps/api/test/integration/assert-test-database.ts refuses to run unless
# ALL of the following hold. It throws before a single connection is opened.
#
#   1. NODE_ENV=test
#   2. DATABASE_URL is a postgresql:// URL
#   3. the database name ends in "_test"
#   4. the host is local (localhost / 127.0.0.1 / a known compose service)
#   5. the URL contains no production marker (amazonaws.com, rds., neon.tech,
#      axlopos.com, prod, production, staging, live, ...)
#   6. port 5432 is only allowed for a compose service name — the test database
#      listens on 5433
#   7. at runtime the target holds fewer than 1000 Sale rows
#
# The suite TRUNCATES every table between tests. Never point it at a database
# whose contents you would miss.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=test

# Matches docker-compose.test.yml — port 5433, database hardware_pos_test.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hardware_pos_test?schema=public"

# Any non-empty value; nothing in the suite verifies a real token.
JWT_SECRET=integration-test-jwt-secret
TOKEN_ENCRYPTION_KEY=integration-test-token-encryption-key

# The queue is driven by assertions, not a timer. Leave this false.
SYNC_WORKER_ENABLED=false

# No spec may reach Intuit. QuickBooks credentials are intentionally absent, so
# any accidental live call fails loudly instead of quietly succeeding.
