# Dependencies
node_modules/
.pnpm-store/

# This repo is pnpm-only (see packageManager in package.json). An npm/yarn
# lockfile here is an accident from a stray `npm install` and drifts from
# pnpm-lock.yaml — ignore it so it can't be committed again.
package-lock.json
yarn.lock

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Turbo
.turbo/

# Environment
.env
.env.local
.env.*.local
.env.prod
.env.test
!.env.example
!.env.prod.example
!.env.test.example

# Prisma
packages/database/prisma/migrations/dev.db*

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Test / coverage
coverage/
# Playwright run artefacts. apps/e2e has its own; a stray run from another
# workspace drops these at that workspace's root.
test-results/
playwright-report/

# Uploaded product images (local dev storage)
apps/api/uploads/
uploads/
.~lock.*#

# D174 — MOCK printers spool to disk (integration tests, dev machines); the
# on-site agent keeps its pairing token in agent.json and its MOCK output beside it.
.print-spool/
apps/print-agent/agent.json
apps/print-agent/agent-spool.bin
