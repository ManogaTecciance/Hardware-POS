# Hardware POS — production env for docker-compose.prod.yml.
# Copy to .env.prod on the EC2 host and fill in real secrets. NEVER commit .env.prod.
#   cp .env.prod.example .env.prod
#
# Every value here is injected straight into the containers (no interpolation).

NODE_ENV=production
API_PORT=4000

# ── Schema migrations ──
# Leave false in production. Migrations are applied as a separate, approved
# deployment step BEFORE replicas are started or updated:
#   docker compose -f docker-compose.prod.yml run --rm api migrate
# Setting this to true makes every container boot run `prisma migrate deploy`,
# which races concurrent replicas and alters the schema with no operator present.
# See docs/restaurant-pos/06-migration-and-rollout.md.
RUN_MIGRATIONS_ON_BOOT=false

# ── Database ──
# Keep POSTGRES_USER=postgres and POSTGRES_DB=hardware_pos (the compose
# healthcheck expects them). Set a strong password, and use THE SAME password
# in DATABASE_URL below. Host is "db" — the compose service name, not localhost.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=hardware_pos
DATABASE_URL="postgresql://postgres:CHANGE_ME_long_random@db:5432/hardware_pos?schema=public"

# ── CORS: the Amplify frontend origin(s) ──
# Comma-separated list of allowed browser origins (no spaces needed). List every
# origin the app is actually served from — e.g. apex + www. The FIRST entry is
# canonical: it's used to build the QuickBooks post-OAuth redirect back to the app.
WEB_ORIGIN=https://axlopos.com,https://www.axlopos.com

# ── Auth ──
JWT_SECRET=CHANGE_ME_long_random_64_chars
JWT_EXPIRES_IN=12h

# Encrypts stored QuickBooks OAuth tokens at rest (required). 32-byte random.
TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_byte_random_secret

# ── Uploads ──
# 'local' writes to UPLOAD_DIR (a mounted volume, set by compose). For durability
# across instance replacement, switch to S3 and fill the block below instead.
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=s3
# S3_BUCKET=hardware-pos-uploads
# S3_REGION=eu-north-1
# (Real AWS S3: omit S3_ENDPOINT and use an IAM role or access keys.)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional tunables (defaults shown):
# S3_SIGNED_URL_TTL_SECONDS=300      # presigned read-URL lifetime, seconds (max 604800)
# IMAGE_MAX_EDGE=780                 # longest edge (px) uploaded images are downscaled to
# IMAGE_WEBP_QUALITY=80              # WebP encoder quality, 1-100
# IMAGE_CACHE_MAX_AGE_SECONDS=21600  # browser cache lifetime for served images, seconds (6h)

# ── QuickBooks Online OAuth ──
# The redirect URI must be HTTPS + public, and must ALSO be registered verbatim
# in the Intuit developer console.
# Use Development (sandbox) keys + a sandbox company for now. Switch ENVIRONMENT
# to 'production' only once you have production keys — it flips the data-API base
# from sandbox-quickbooks.api.intuit.com to quickbooks.api.intuit.com.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://api.axlopos.com/v1/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# ── Public share links (quotations) ──
PUBLIC_SHARE_BASE_URL=https://api.axlopos.com/v1

# ── Email ──
MAIL_PROVIDER=log
MAIL_FROM=Hardware POS <no-reply@axlopos.com>
# Resend:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# SMTP:
# MAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
