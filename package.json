{
  "name": "hardware-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Hardware POS — a cashier sales front-end that syncs with QuickBooks Online (inventory & accounting source of truth).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@hardware-pos/web",
    "dev:api": "turbo run dev --filter=@hardware-pos/api",
    "dev:agent": "pnpm --filter @hardware-pos/print-agent agent",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm test:integration:up && pnpm test:integration:run; status=$?; pnpm test:integration:down; exit $status",
    "test:integration:run": "NODE_ENV=test DATABASE_URL=\"postgresql://postgres:postgres@localhost:5433/hardware_pos_test?schema=public\" JWT_SECRET=integration-test-jwt-secret TOKEN_ENCRYPTION_KEY=integration-test-token-encryption-key SYNC_WORKER_ENABLED=false turbo run test:integration --filter=@hardware-pos/api",
    "test:integration:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @hardware-pos/database db:generate",
    "db:migrate": "pnpm --filter @hardware-pos/database db:migrate",
    "db:seed": "pnpm --filter @hardware-pos/database db:seed",
    "db:studio": "pnpm --filter @hardware-pos/database db:studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
