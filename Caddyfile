# Caddy terminates TLS for the whole stack. On first boot it obtains free
# Let's Encrypt certificates for every site below over the ACME HTTP-01
# challenge (needs ports 80 + 443 open on the host firewall and DNS already
# pointing here) and auto-renews them.
#
# Sites:
#   axlopos.com, www.axlopos.com -> web:3000  (Next.js front-end)
#   api.axlopos.com              -> api:4000  (the /v1 API, /uploads static
#                                              images, and the QuickBooks OAuth
#                                              callback share this one origin)

(security_headers) {
	header {
		# Browsers refuse plain HTTP for a year once they have seen this.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Don't advertise the proxy software.
		-Server
	}
}

axlopos.com, www.axlopos.com {
	encode zstd gzip
	import security_headers

	reverse_proxy web:3000

	log
}

api.axlopos.com {
	encode zstd gzip
	import security_headers

	# Product-image uploads can be a few MB; lift the default request cap.
	request_body {
		max_size 25MB
	}

	reverse_proxy api:4000

	# Access logs to stdout (view with `docker compose logs caddy`).
	log
}
