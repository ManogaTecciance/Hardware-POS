{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": ["**/.env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      // Never cached: the result depends on an external PostgreSQL container, so a
      // cache hit would report a pass without having touched the database.
      "cache": false,
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "TOKEN_ENCRYPTION_KEY",
        "SYNC_WORKER_ENABLED"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
